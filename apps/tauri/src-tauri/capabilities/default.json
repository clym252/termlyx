{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: only the Tether commands, event listening, and closing its own window (after the quit confirmation), and the native open-file picker; no other core, shell or fs plugin permissions",
  "windows": ["main"],
  "permissions": [
    "allow-open-session",
    "allow-write-shell",
    "allow-resize-shell",
    "allow-ack-shell",
    "allow-close-shell",
    "allow-close-all-sessions",
    "allow-active-work",
    "allow-local-shells",
    "allow-session-tmux",
    "allow-vault-status",
    "allow-vault-create",
    "allow-vault-unlock",
    "allow-vault-unlock-recovery",
    "allow-vault-lock",
    "allow-vault-enable-quick-unlock",
    "allow-vault-disable-quick-unlock",
    "allow-vault-quick-unlock",
    "allow-set-auto-lock",
    "allow-app-front",
    "allow-set-device-fallback",
    "allow-list-entities",
    "allow-upsert-entity",
    "allow-delete-entity",
    "allow-delete-group",
    "allow-set-own-login",
    "allow-effective-settings",
    "allow-import-ssh-config",
    "allow-key-generate",
    "allow-key-import",
    "allow-key-export-private",
    "allow-known-hosts-import",
    "allow-sync-status",
    "allow-sync-parse-code",
    "allow-sync-check-server",
    "allow-sync-enable",
    "allow-sync-join",
    "allow-sync-recover",
    "allow-sync-now",
    "allow-sync-pause",
    "allow-sync-sign-in",
    "allow-sync-turn-off",
    "allow-sync-link-code",
    "allow-sync-devices",
    "allow-sync-rename-device",
    "allow-sync-revoke-device",
    "allow-vault-change-password",
    "allow-conflicts-list",
    "allow-conflicts-resolve",
    "allow-conflicts-reveal",
    "allow-sftp-open",
    "allow-sftp-close",
    "allow-sftp-list",
    "allow-sftp-mkdir",
    "allow-sftp-rename",
    "allow-sftp-remove",
    "allow-sftp-chmod",
    "allow-transfer-enqueue",
    "allow-transfer-cancel",
    "allow-local-list",
    "allow-local-mkdir",
    "allow-local-resolve",
    "allow-local-drives",
    "allow-local-import",
    "allow-sftp-realpath",
    "allow-forward-start",
    "allow-forward-stop",
    "allow-forward-statuses",
    "allow-keepalive-set",
    "allow-keepalive-status",
    "allow-prompt-respond",
    "allow-move-to-background",
    "allow-local-import-from-device",
    "allow-local-save-to-device",
    "core:app:allow-version",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-destroy",
    "dialog:allow-open"
  ]
}
