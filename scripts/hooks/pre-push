#!/usr/bin/env bash
# Enable with: git config core.hooksPath scripts/hooks
# Needs gitleaks on PATH and TERMLYX_PERSONAL_PATTERNS pointing at the private pattern file.
set -e
cd "$(git rev-parse --show-toplevel)"
gitleaks git . -c .gitleaks.toml --redact
scripts/scan-personal.sh   # exits 2 loudly if the pattern file is missing
