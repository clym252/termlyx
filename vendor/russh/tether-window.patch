+/// Grants receive window to channels of one session, for
+/// [`Config::manual_window_adjust`]. Cheap to clone; it does not keep the
+/// session alive.
+///
+/// Grants go on the session's priority queue, which the session loop serves
+/// whenever no key exchange is running, even while other channels' outbound
+/// data waits on the server's window (the normal outbound queue is not
+/// served then). So one write-blocked channel cannot stop the window, and
+/// with it the inbound data, of the others.
+#[derive(Clone, Debug)]
+pub struct WindowGranter {
+    sender: UnboundedSender<Msg>,
+}
+
+impl WindowGranter {
+    /// Grants the server `bytes` more receive window on `channel`. Never
+    /// waits. Fails only once the session has ended.
+    pub fn adjust_window(&self, channel: ChannelId, bytes: u32) -> Result<(), Error> {
+        self.sender
+            .send(Msg::Channel(channel, ChannelMsg::AdjustWindow { bytes }))
+            .map_err(|_| Error::SendError)
+    }
 }
 
