+    /// Manual window mode: account for received data without refilling the
+    /// window (see `client::Config::manual_window_adjust`).
+    pub fn consume_window(&mut self, channel: ChannelId, data: &[u8]) {
+        if let Some(channel) = self.channels.get_mut(&channel) {
+            let len = u32::try_from(data.len()).unwrap_or(u32::MAX);
+            channel.sender_window_size = channel.sender_window_size.saturating_sub(len);
+        }
+    }
+
+    /// Manual window mode: grant the peer `bytes` more window on `channel`,
+    /// capped so the window never exceeds 2^32-1 (RFC 4254 section 5.2).
+    pub fn grant_window(&mut self, channel: ChannelId, bytes: u32) -> Result<(), crate::Error> {
+        if let Some(channel) = self.channels.get_mut(&channel) {
+            let bytes = bytes.min(u32::MAX - channel.sender_window_size);
+            if bytes == 0 || !channel.confirmed {
+                return Ok(());
+            }
+            push_packet!(self.write, {
+                self.write.push(msg::CHANNEL_WINDOW_ADJUST);
+                channel.recipient_channel.encode(&mut self.write)?;
+                bytes.encode(&mut self.write)?;
+            });
+            channel.sender_window_size += bytes;
+        }
+        Ok(())
+    }
